config_version=5

[application]

config/name="White Phosphorus: An Explosive Escape"
config/description="A small platformer about a phosphorus character who survives in water, burns in air, and uncovers strange facts about phosphorus along the way."
run/main_scene="uid://4ht2ox1qqc7q"
config/features=PackedStringArray("4.6", "Forward Plus")
boot_splash/show_image=false
boot_splash/use_filter=false
config/icon="res://icon.svg"
boot_splash/show_godot_logo=false

[audio]

buses/default_bus_layout="uid://b8wr0hwoqop4v"

[autoload]

utils="*uid://bsfeki27pyrgy"
sound_manager="*uid://dli2v7y1atlqn"
bg_music="*uid://ba72tpgnbuoda"
ui_manager="*uid://bbb0232q636ie"

[display]

